{
  "id": "flux-t2i",
  "label": "FLUX Text to Image",
  "family": "FLUX",
  "description": "Text-to-image through a FLUX checkpoint graph on ComfyUI.",
  "mode": "image",
  "source": "docs/providers/comfyui.md",
  "graph": {
    "1": { "class_type": "CheckpointLoaderSimple", "inputs": { "ckpt_name": "flux1-dev.safetensors" } },
    "2": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] } },
    "3": { "class_type": "CLIPTextEncode", "inputs": { "text": "", "clip": ["1", 1] } },
    "4": { "class_type": "EmptyLatentImage", "inputs": { "width": 1024, "height": 1024, "batch_size": 1 } },
    "5": { "class_type": "KSampler", "inputs": { "seed": 0, "steps": 28, "cfg": 1, "sampler_name": "euler", "scheduler": "normal", "denoise": 1, "model": ["1", 0], "positive": ["2", 0], "negative": ["3", 0], "latent_image": ["4", 0] } },
    "6": { "class_type": "VAEDecode", "inputs": { "samples": ["5", 0], "vae": ["1", 2] } },
    "7": { "class_type": "SaveImage", "inputs": { "filename_prefix": "lh-video", "images": ["6", 0] } }
  },
  "params": [
    { "id": "prompt", "label": "Prompt", "type": "string", "target": ["2", "text"], "required": true, "maxLength": 4096 },
    { "id": "negative_prompt", "label": "Negative prompt", "type": "string", "target": ["3", "text"], "default": "", "maxLength": 2048, "description": "Text encoded into the negative prompt of the sampler graph." },
    { "id": "width", "label": "Width", "type": "integer", "target": ["4", "width"], "default": 1024, "minimum": 256, "maximum": 2048, "description": "Output width in pixels. ComfyUI decodes widths in multiples of 8." },
    { "id": "height", "label": "Height", "type": "integer", "target": ["4", "height"], "default": 1024, "minimum": 256, "maximum": 2048, "description": "Output height in pixels. ComfyUI decodes heights in multiples of 8." },
    { "id": "steps", "label": "Steps", "type": "integer", "target": ["5", "steps"], "default": 28, "minimum": 1, "maximum": 60, "description": "Sampler steps applied by the KSampler node." },
    { "id": "cfg", "label": "CFG", "type": "number", "target": ["5", "cfg"], "default": 1, "minimum": 0, "maximum": 30, "description": "Classifier-free guidance scale passed to the KSampler node." },
    { "id": "seed", "label": "Seed", "type": "integer", "target": ["5", "seed"], "default": 0, "minimum": 0, "maximum": 4294967295, "description": "Sampler seed. The same seed and graph reproduce the same image." }
  ],
  "mediaSlots": [],
  "outputs": [{ "node": "7", "kind": "image", "mimeType": "image/png" }]
}
